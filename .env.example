# Copy to .env. Select ONE provider/key profile. Never commit credentials.
# Official OpenAI (default for a new installation):
LLM_PROVIDER=openai
OPENAI_API_KEY=replace_with_your_api_key
# LLM_API_KEY is also supported. Do not keep two different nonempty keys.
# Leave LLM_BASE_URL unset to use the selected provider's validated endpoint.
# LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1

# AvalAI alternative: replace the provider/key lines above with these:
# LLM_PROVIDER=avalai
# LLM_API_KEY=replace_with_your_api_token
# LLM_BASE_URL=https://api.avalai.org/v1
# The existing https://api.avalai.ir/v1 endpoint is also accepted.
# Legacy .env without LLM_PROVIDER retains AvalAI behavior.

# Another OpenAI-compatible service requires an explicit custom profile:
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_API_KEY=replace_with_your_api_token
# OPENAI_API_KEY is never used by avalai/custom profiles.

# Chat and embeddings use the same configured provider and API key.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64

# Bounded pacing/retries; increase the interval for a lower account rate limit.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MIN_INTERVAL_SECONDS=3
# AvalAI accounts used for this demo needed 30 seconds; set 30 for that profile.

# Stable interpretation of relative dates in the supplied business snapshot.
AS_OF=2026-11-16

# Optional tracing. Local execution evidence works without these credentials.
LANGFUSE_ENABLED=false
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
